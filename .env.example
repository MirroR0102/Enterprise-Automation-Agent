# LLM：默认 DeepSeek（OpenAI 兼容）。演示可切 GPT-4o-mini 或预留 Qwen。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 演示对比用（LLM_PROVIDER=openai 时）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 预留 Qwen（LLM_PROVIDER=qwen 时）
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=Qwen2-72B-Instruct

TAVILY_API_KEY=

# 真实 MySQL。本地无 MySQL 时保持 USE_MOCK_DB=true
USE_MOCK_DB=true
MYSQL_DSN=mysql://root:password@127.0.0.1:3306/enterprise_ops

JWT_SECRET=change-me-in-production-use-at-least-32-chars
JWT_EXPIRE_MINUTES=720

MAX_TOOL_ROUNDS=8
TASK_TIMEOUT_S=30
REPORTS_DIR=reports

# 第 3 部分知识库。默认 Stub，不阻塞本项目验收
KB_ENABLED=false
KB_BASE_URL=
KB_API_KEY=
KB_TIMEOUT_S=3

# 演示账号（仅文档；数据库里存哈希）
# ops / ops123  （运营）
# dev / dev123  （开发维护）
